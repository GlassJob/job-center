{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/task.completed.json",
  "title": "task.completed",
  "description": "方向：E→C",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "task.completed"
    },
    "data": {
      "type": "object",
      "required": [
        "attempt_id",
        "lease_token",
        "finished_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lease_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "lease_token（fencing token）"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0
        },
        "result": {},
        "next_state": {
          "type": [
            "object",
            "null"
          ],
          "description": "完成时原子推进的新状态对象（≤ 64 KiB；未传或 null 保持原状态不变）"
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}