{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/task.log.json",
  "title": "task.log",
  "description": "方向：E→C",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "task.log"
    },
    "data": {
      "type": "object",
      "required": [
        "attempt_id",
        "lease_token",
        "entries"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lease_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "lease_token（fencing token）"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "type": "object",
            "required": [
              "seq",
              "level",
              "ts",
              "message"
            ],
            "properties": {
              "seq": {
                "type": "integer",
                "minimum": 1
              },
              "level": {
                "enum": [
                  "DEBUG",
                  "INFO",
                  "WARN",
                  "ERROR"
                ]
              },
              "ts": {
                "type": "string",
                "format": "date-time"
              },
              "message": {
                "type": "string",
                "maxLength": 8192
              },
              "stream": {
                "enum": [
                  "stdout",
                  "stderr"
                ]
              },
              "fields": {
                "type": "object"
              },
              "truncated": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          }
        },
        "dropped": {
          "type": "integer",
          "minimum": 0,
          "description": "本批之前因背压丢弃的条数"
        }
      },
      "additionalProperties": false
    }
  }
}