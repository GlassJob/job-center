{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/system.error.json",
  "title": "system.error",
  "description": "方向：双向",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "system.error"
    },
    "data": {
      "type": "object",
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "message": {
          "type": "string",
          "maxLength": 2000
        },
        "retryable": {
          "type": "boolean"
        },
        "ref_message_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "details": {
          "type": "object"
        }
      },
      "additionalProperties": false
    }
  }
}