{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/task.progress.json",
  "title": "task.progress",
  "description": "方向：E→C",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "task.progress"
    },
    "data": {
      "type": "object",
      "required": [
        "attempt_id",
        "lease_token"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lease_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "lease_token（fencing token）"
        },
        "percent": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "message": {
          "type": "string",
          "maxLength": 500
        },
        "current": {
          "type": "integer"
        },
        "total": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}