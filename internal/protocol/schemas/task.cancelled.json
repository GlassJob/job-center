{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/task.cancelled.json",
  "title": "task.cancelled",
  "description": "方向：E→C",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "task.cancelled"
    },
    "data": {
      "type": "object",
      "required": [
        "attempt_id",
        "lease_token",
        "finished_at",
        "stopped_by"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lease_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "lease_token（fencing token）"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time"
        },
        "duration_ms": {
          "type": "integer"
        },
        "stopped_by": {
          "enum": [
            "COOPERATIVE",
            "SIGTERM",
            "SIGKILL",
            "NOT_STARTED"
          ]
        },
        "exit_code": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}