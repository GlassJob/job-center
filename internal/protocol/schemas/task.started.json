{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://jobcenter.local/schemas/ws/1.0/task.started.json",
  "title": "task.started",
  "description": "方向：E→C",
  "allOf": [
    {
      "$ref": "envelope.json"
    }
  ],
  "properties": {
    "type": {
      "const": "task.started"
    },
    "data": {
      "type": "object",
      "required": [
        "attempt_id",
        "lease_token",
        "started_at"
      ],
      "properties": {
        "attempt_id": {
          "type": "string",
          "pattern": "^[0-9A-HJKMNP-TV-Z]{26}$"
        },
        "lease_token": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$",
          "description": "lease_token（fencing token）"
        },
        "started_at": {
          "type": "string",
          "format": "date-time"
        },
        "pid": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}