meta {
  name: Create credential
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/admin/services/{{service_id}}/credentials
  body: json
  auth: none
}

body:json {
  {
    "name": "executor-default",
    "allowed_job_codes": ["demo.*"],
    "allowed_ips": null,
    "expires_at": null
  }
}

docs {
  # Create credential
  
  - `allowed_ips`: null=不限制；数组为 IP/CIDR，用于 WS HMAC
  - 响应一次性 `secret`（写入 `executor_secret`，WS 签名）
  - 服务端同时写入 `secret_enc`，供 Gateway 验签
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    if (res.body.data.id) {
      bru.setEnvVar('credential_id', res.body.data.id);
    }
    if (res.body.data.token) {
      bru.setEnvVar('executor_credential', res.body.data.token);
    }
    if (res.body.data.secret) {
      bru.setEnvVar('executor_secret', res.body.data.secret);
      console.log('new credential secret (save once):', res.body.data.secret);
      console.log('WS: set auth_timestamp/nonce/signature then open executor → WS Gateway');
    }
  }
}
