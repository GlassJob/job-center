meta {
  name: Create credential
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/admin/services/{{service_id}}/credentials
  body: json
  auth: none
}

body:json {
  {
    "name": "executor-default",
    "allowed_job_codes": ["demo.*"],
    "expires_at": null
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    if (res.body.data.id) {
      bru.setEnvVar('credential_id', res.body.data.id);
    }
    if (res.body.data.secret) {
      console.log('new credential secret (save once):', res.body.data.secret);
    }
  }
}
