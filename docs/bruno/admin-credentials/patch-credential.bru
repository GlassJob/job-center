meta {
  name: Patch credential
  type: http
  seq: 4
}

patch {
  url: {{base_url}}/v1/admin/services/{{service_id}}/credentials/{{credential_id}}
  body: json
  auth: none
}

body:json {
  {
    "name": "executor-default",
    "allowed_job_codes": ["demo.echo", "demo.*"],
    "allowed_ips": ["127.0.0.1", "::1"],
    "clear_allowed_ips": false,
    "clear_expires_at": true
  }
}

docs {
  # Patch credential
  
  - `allowed_ips` / `clear_allowed_ips`：更新或清空 IP 白名单
  - `allowed_job_codes` / `clear_allowed_job_codes`：同上
}
