meta {
  name: Create client
  type: http
  seq: 2
}

post {
  url: {{base_url}}/v1/admin/clients
  body: json
  auth: none
}

body:json {
  {
    "name": "ci-bot",
    "description": "from bruno",
    "scopes": ["job.service.view", "job.service.manage"]
  }
}

script:post-response {
  if (res.status === 200 && res.body && res.body.data) {
    if (res.body.data.id) {
      bru.setEnvVar('managed_client_id', res.body.data.id);
    }
    if (res.body.data.secret) {
      console.log('new client secret (save once):', res.body.data.secret);
    }
  }
}
