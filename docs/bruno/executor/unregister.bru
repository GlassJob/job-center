meta {
  name: Unregister (HTTP 联调)
  type: http
  seq: 4
}

post {
  url: {{base_url}}/v1/executor/unregister
  body: json
  auth: none
}

headers {
  X-JC-Credential: {{executor_credential}}
  X-JC-Instance-Id: {{instance_id}}
  X-JC-Session-Id: {{session_id}}
  X-JC-Session-Epoch: {{session_epoch}}
}

body:json {
  {
    "reason": "shutdown"
  }
}
